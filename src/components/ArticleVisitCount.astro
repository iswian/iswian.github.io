---
interface Props {
  slug: string
  title: string
}

const { slug, title } = Astro.props
const apiBaseUrl =
  import.meta.env.PUBLIC_CWD_API_BASE_URL ??
  (import.meta.env.PROD ? "https://api.iswian.cn" : "")
const elementId = `article-visit-${slug.replace(/[^a-zA-Z0-9_-]/g, "-")}`
---

<span
  id={elementId}
  class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-primary/8 px-2.5 py-1 font-mono tabular-nums text-foreground"
  data-api-base-url={apiBaseUrl}
  data-post-slug={slug}
  data-post-title={title}
  aria-label="页面访问次数"
>
  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
    />
    <circle cx="12" cy="12" r="2.5" stroke-width="2" />
  </svg>
  <span data-visit-value>0</span>
  <span>次访问</span>
</span>

<script
  is:inline
  data-element-id={elementId}
>
  (() => {
    const currentScript = document.currentScript
    const elementId = currentScript?.dataset.elementId
    if (!elementId) return

    const updateVisitCount = async () => {
      const element = document.getElementById(elementId)
      if (!(element instanceof HTMLElement) || element.dataset.loading === "true") return

      const apiBaseUrl = element.dataset.apiBaseUrl
      const postSlug = element.dataset.postSlug
      const postTitle = element.dataset.postTitle
      const valueElement = element.querySelector("[data-visit-value]")
      if (!apiBaseUrl || !postSlug || !(valueElement instanceof HTMLElement)) return

      element.dataset.loading = "true"
      const sessionKey = `iswian-visited:${postSlug}`
      const alreadyCounted = sessionStorage.getItem(sessionKey) === "true"

      try {
        const endpoint = `${apiBaseUrl}/api/analytics/visit`
        const response = alreadyCounted
          ? await fetch(`${endpoint}?post_slug=${encodeURIComponent(postSlug)}`)
          : await fetch(endpoint, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                postSlug,
                postTitle,
                postUrl: window.location.href,
              }),
            })

        if (!response.ok) throw new Error(`HTTP ${response.status}`)
        const payload = await response.json()
        const pv = Number(payload?.pv)
        if (Number.isFinite(pv) && pv >= 0) {
          valueElement.textContent = Math.trunc(pv).toLocaleString("en-US")
          if (!alreadyCounted) sessionStorage.setItem(sessionKey, "true")
        }
      } catch (error) {
        console.warn("访问次数加载失败", error)
      } finally {
        delete element.dataset.loading
      }
    }

    updateVisitCount()
    document.addEventListener("astro:page-load", updateVisitCount)
  })()
</script>
